program TestStdlib {
    import std;
    main {
        // 测试 srand 和 rand
        std.srand(42);
        let r1 = std.rand();
        let r2 = std.rand();
        output(r1);
        output(r2);

        // 测试 sleep_ms（短暂休眠）
        let t1 = std.clock_ms();
        std.sleep_ms(50);
        let t2 = std.clock_ms();
        // t2 - t1 应该 >= 50ms
        let elapsed: float = t2 - t1;
        // 输出是否至少休眠了 40ms（给一些容差）
        if (elapsed > 40.0) {
            output(1);
        } else {
            output(0);
        };

        // 测试 rand 返回非负数
        std.srand(123);
        let ok = 1;
        let i = 0;
        while (i < 100) {
            if (std.rand() < 0) {
                ok = 0;
            };
            i = i + 1;
        };
        output(ok);
    }
}
