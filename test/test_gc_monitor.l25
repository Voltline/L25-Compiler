// 测试 GC 监测函数
program gc_monitor_test {
    class Node {
        let value: int;
    }

    main {
        // 初始状态
        let count0: int = gc_count();
        output(count0);

        // 分配一些对象
        let a: *Node = new Node();
        a.value = 10;

        let b: *Node = new Node();
        b.value = 20;

        let c: *Node = new Node();
        c.value = 30;

        let count1: int = gc_count();
        output(count1);

        // 打印 GC 统计信息（输出到 stderr）
        gc_stats();

        // 手动触发 GC
        gc_collect();

        // 暂停/恢复测试
        gc_pause();
        gc_resume();

        output(gc_count());
    }
}
