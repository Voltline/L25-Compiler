// ==============================================
// bench_parallel.l25  –  并行 vs 串行质数计算压测
//
// 任务: 统计 [2, N] 中质数个数
// 方法: 逐个试除法 (故意用较慢的算法以增加负载)
//
// 串行: 单线程算完整区间
// 并行: 将区间分成 NWORKERS 段, 每段 spawn 一个 goroutine
//        结果通过 channel 汇总
// ==============================================

program BenchParallel {

    // ---- 朴素质数判断 ----
    func is_prime(n: int) -> int {
        let result: int = 1;
        if (n < 2) {
            result = 0;
        } else {
            if (n < 4) {
                result = 1;
            } else {
                if (n % 2 == 0) {
                    result = 0;
                } else {
                    let d: int = 3;
                    while (d * d <= n) {
                        if (n % d == 0) {
                            result = 0;
                        };
                        d = d + 2;
                    };
                };
            };
        };
        return result;
    }

    // ---- 统计 [lo, hi) 中的质数个数 ----
    func count_primes_range(lo, hi: int) -> int {
        let cnt: int = 0;
        let i: int = lo;
        while (i < hi) {
            cnt = cnt + is_prime(i);
            i = i + 1;
        };
        return cnt;
    }

    main {
        let N: int = 2000000;
        let NWORKERS: int = 8;

        output("========================================");
        printf("  Benchmark: prime count in [2, %d]\n", N);
        printf("  Workers:   %d\n", NWORKERS);
        output("========================================");

        // --- 串行 ---
        let t0: float = clock_ms();
        let serial_result: int = count_primes_range(2, N + 1);
        let t1: float = clock_ms();
        let serial_ms: float = t1 - t0;
        printf("  Serial   result = %d\n", serial_result);
        printf("  Serial   time   = %.1f ms\n", serial_ms);

        // --- 并行 ---
        let ch: channel<int, 8>;
        let range_size: int = (N - 1) / NWORKERS;

        let t2: float = clock_ms();

        let lo0: int = 2 + 0 * range_size;
        let hi0: int = lo0 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo0, hi0);
            ch.send(cnt);
        };

        let lo1: int = 2 + 1 * range_size;
        let hi1: int = lo1 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo1, hi1);
            ch.send(cnt);
        };

        let lo2: int = 2 + 2 * range_size;
        let hi2: int = lo2 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo2, hi2);
            ch.send(cnt);
        };

        let lo3: int = 2 + 3 * range_size;
        let hi3: int = lo3 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo3, hi3);
            ch.send(cnt);
        };

        let lo4: int = 2 + 4 * range_size;
        let hi4: int = lo4 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo4, hi4);
            ch.send(cnt);
        };

        let lo5: int = 2 + 5 * range_size;
        let hi5: int = lo5 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo5, hi5);
            ch.send(cnt);
        };

        let lo6: int = 2 + 6 * range_size;
        let hi6: int = lo6 + range_size;
        spawn {
            let cnt: int = count_primes_range(lo6, hi6);
            ch.send(cnt);
        };

        let lo7: int = 2 + 7 * range_size;
        let hi7: int = N + 1;
        spawn {
            let cnt: int = count_primes_range(lo7, hi7);
            ch.send(cnt);
        };

        // 汇总
        let parallel_result: int = 0;
        let received: int = 0;
        while (received < NWORKERS) {
            let partial: int = ch.recv();
            parallel_result = parallel_result + partial;
            received = received + 1;
        };

        let t3: float = clock_ms();
        let parallel_ms: float = t3 - t2;
        printf("  Parallel result = %d\n", parallel_result);
        printf("  Parallel time   = %.1f ms\n", parallel_ms);

        // --- 速度比 ---
        output("----------------------------------------");
        let speedup: float = serial_ms / parallel_ms;
        printf("  Speedup  = %.2fx\n", speedup);
        if (serial_result == parallel_result) {
            printf("  Result check: PASS\n");
        } else {
            printf("  Result check: FAIL !!!\n");
        };
        output("========================================");
    }
}


