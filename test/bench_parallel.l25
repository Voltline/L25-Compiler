        let c55hi: int = c55lo + chunk_size;
        spawn { ch.send(count_primes_range(c55lo, c55hi)); };

        // chunk 56..63 (最后一块覆盖到 N+1)
        let c56lo: int = 2 + 56 * chunk_size;
        let c56hi: int = c56lo + chunk_size;
        spawn { ch.send(count_primes_range(c56lo, c56hi)); };
        let c57lo: int = 2 + 57 * chunk_size;
        let c57hi: int = c57lo + chunk_size;
        spawn { ch.send(count_primes_range(c57lo, c57hi)); };
        let c58lo: int = 2 + 58 * chunk_size;
        let c58hi: int = c58lo + chunk_size;
        spawn { ch.send(count_primes_range(c58lo, c58hi)); };
        let c59lo: int = 2 + 59 * chunk_size;
        let c59hi: int = c59lo + chunk_size;
        spawn { ch.send(count_primes_range(c59lo, c59hi)); };
        let c60lo: int = 2 + 60 * chunk_size;
        let c60hi: int = c60lo + chunk_size;
        spawn { ch.send(count_primes_range(c60lo, c60hi)); };
        let c61lo: int = 2 + 61 * chunk_size;
        let c61hi: int = c61lo + chunk_size;
        spawn { ch.send(count_primes_range(c61lo, c61hi)); };
        let c62lo: int = 2 + 62 * chunk_size;
        let c62hi: int = c62lo + chunk_size;
        spawn { ch.send(count_primes_range(c62lo, c62hi)); };
        let c63lo: int = 2 + 63 * chunk_size;
        let c63hi: int = N + 1;
        spawn { ch.send(count_primes_range(c63lo, c63hi)); };

        // 汇总
        let parallel_result: int = 0;
        let received: int = 0;
        while (received < NCHUNKS) {
            let partial: int = ch.recv();
            parallel_result = parallel_result + partial;
            received = received + 1;
        };

        let t3: float = clock_ms();
        let parallel_ms: float = t3 - t2;
        printf("  Parallel result = %d\n", parallel_result);
        printf("  Parallel time   = %.1f ms\n", parallel_ms);

        // --- 速度比 ---
        output("----------------------------------------");
        let speedup: float = serial_ms / parallel_ms;
        printf("  Speedup  = %.2fx\n", speedup);
        if (serial_result == parallel_result) {
            printf("  Result check: PASS\n");
        } else {
            printf("  Result check: FAIL !!!\n");
        };
        output("========================================");
    }
}
