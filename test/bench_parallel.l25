// ==============================================
// bench_parallel.l25  –  并行 vs 串行质数计算压测
//
// 任务: 统计 [2, N] 中质数个数
// 方法: 逐个试除法
//
// 串行: 单线程算完整区间
// 并行: 将区间分成 NCHUNKS 段 (细粒度), spawn NCHUNKS 个任务
//        线程池自动调度, 结果通过 channel 汇总
// ==============================================

program BenchParallel {

    // ---- 朴素质数判断 (含 break 优化) ----
    func is_prime(n: int) -> int {
        let result: int = 1;
        if (n < 2) {
            result = 0;
        } else {
            if (n < 4) {
                result = 1;
            } else {
                if (n % 2 == 0) {
                    result = 0;
                } else {
                    let d: int = 3;
                    let found: int = 0;
                    while (d * d <= n && found == 0) {
                        if (n % d == 0) {
                            result = 0;
                            found = 1;
                        };
                        d = d + 2;
                    };
                };
            };
        };
        return result;
    }

    // ---- 统计 [lo, hi) 中的质数个数 ----
    func count_primes_range(lo, hi: int) -> int {
        let cnt: int = 0;
        let i: int = lo;
        while (i < hi) {
            cnt = cnt + is_prime(i);
            i = i + 1;
        };
        return cnt;
    }

    main {
        let N: int = 2000000;
        let NCHUNKS: int = 64;

        output("========================================");
        printf("  Benchmark: prime count in [2, %d]\n", N);
        printf("  Chunks:    %d\n", NCHUNKS);
        output("========================================");

        // --- 串行 ---
        let t0: float = clock_ms();
        let serial_result: int = count_primes_range(2, N + 1);
        let t1: float = clock_ms();
        let serial_ms: float = t1 - t0;
        printf("  Serial   result = %d\n", serial_result);
        printf("  Serial   time   = %.1f ms\n", serial_ms);

        // --- 并行: 64 个细粒度任务块 ---
        let ch: channel<int, 64>;
        let total_range: int = N - 1;
        let chunk_size: int = total_range / NCHUNKS;

        let t2: float = clock_ms();

        // chunk 0..7
        let c0lo: int = 2 + 0 * chunk_size;
        let c0hi: int = c0lo + chunk_size;
        spawn { ch.send(count_primes_range(c0lo, c0hi)); };
        let c1lo: int = 2 + 1 * chunk_size;
        let c1hi: int = c1lo + chunk_size;
        spawn { ch.send(count_primes_range(c1lo, c1hi)); };
        let c2lo: int = 2 + 2 * chunk_size;
        let c2hi: int = c2lo + chunk_size;
        spawn { ch.send(count_primes_range(c2lo, c2hi)); };
        let c3lo: int = 2 + 3 * chunk_size;
        let c3hi: int = c3lo + chunk_size;
        spawn { ch.send(count_primes_range(c3lo, c3hi)); };
        let c4lo: int = 2 + 4 * chunk_size;
        let c4hi: int = c4lo + chunk_size;
        spawn { ch.send(count_primes_range(c4lo, c4hi)); };
        let c5lo: int = 2 + 5 * chunk_size;
        let c5hi: int = c5lo + chunk_size;
        spawn { ch.send(count_primes_range(c5lo, c5hi)); };
        let c6lo: int = 2 + 6 * chunk_size;
        let c6hi: int = c6lo + chunk_size;
        spawn { ch.send(count_primes_range(c6lo, c6hi)); };
        let c7lo: int = 2 + 7 * chunk_size;
        let c7hi: int = c7lo + chunk_size;
        spawn { ch.send(count_primes_range(c7lo, c7hi)); };

        // chunk 8..15
        let c8lo: int = 2 + 8 * chunk_size;
        let c8hi: int = c8lo + chunk_size;
        spawn { ch.send(count_primes_range(c8lo, c8hi)); };
        let c9lo: int = 2 + 9 * chunk_size;
        let c9hi: int = c9lo + chunk_size;
        spawn { ch.send(count_primes_range(c9lo, c9hi)); };
        let c10lo: int = 2 + 10 * chunk_size;
        let c10hi: int = c10lo + chunk_size;
        spawn { ch.send(count_primes_range(c10lo, c10hi)); };
        let c11lo: int = 2 + 11 * chunk_size;
        let c11hi: int = c11lo + chunk_size;
        spawn { ch.send(count_primes_range(c11lo, c11hi)); };
        let c12lo: int = 2 + 12 * chunk_size;
        let c12hi: int = c12lo + chunk_size;
        spawn { ch.send(count_primes_range(c12lo, c12hi)); };
        let c13lo: int = 2 + 13 * chunk_size;
        let c13hi: int = c13lo + chunk_size;
        spawn { ch.send(count_primes_range(c13lo, c13hi)); };
        let c14lo: int = 2 + 14 * chunk_size;
        let c14hi: int = c14lo + chunk_size;
        spawn { ch.send(count_primes_range(c14lo, c14hi)); };
        let c15lo: int = 2 + 15 * chunk_size;
        let c15hi: int = c15lo + chunk_size;
        spawn { ch.send(count_primes_range(c15lo, c15hi)); };

        // chunk 16..23
        let c16lo: int = 2 + 16 * chunk_size;
        let c16hi: int = c16lo + chunk_size;
        spawn { ch.send(count_primes_range(c16lo, c16hi)); };
        let c17lo: int = 2 + 17 * chunk_size;
        let c17hi: int = c17lo + chunk_size;
        spawn { ch.send(count_primes_range(c17lo, c17hi)); };
        let c18lo: int = 2 + 18 * chunk_size;
        let c18hi: int = c18lo + chunk_size;
        spawn { ch.send(count_primes_range(c18lo, c18hi)); };
        let c19lo: int = 2 + 19 * chunk_size;
        let c19hi: int = c19lo + chunk_size;
        spawn { ch.send(count_primes_range(c19lo, c19hi)); };
        let c20lo: int = 2 + 20 * chunk_size;
        let c20hi: int = c20lo + chunk_size;
        spawn { ch.send(count_primes_range(c20lo, c20hi)); };
        let c21lo: int = 2 + 21 * chunk_size;
        let c21hi: int = c21lo + chunk_size;
        spawn { ch.send(count_primes_range(c21lo, c21hi)); };
        let c22lo: int = 2 + 22 * chunk_size;
        let c22hi: int = c22lo + chunk_size;
        spawn { ch.send(count_primes_range(c22lo, c22hi)); };
        let c23lo: int = 2 + 23 * chunk_size;
        let c23hi: int = c23lo + chunk_size;
        spawn { ch.send(count_primes_range(c23lo, c23hi)); };

        // chunk 24..31
        let c24lo: int = 2 + 24 * chunk_size;
        let c24hi: int = c24lo + chunk_size;
        spawn { ch.send(count_primes_range(c24lo, c24hi)); };
        let c25lo: int = 2 + 25 * chunk_size;
        let c25hi: int = c25lo + chunk_size;
        spawn { ch.send(count_primes_range(c25lo, c25hi)); };
        let c26lo: int = 2 + 26 * chunk_size;
        let c26hi: int = c26lo + chunk_size;
        spawn { ch.send(count_primes_range(c26lo, c26hi)); };
        let c27lo: int = 2 + 27 * chunk_size;
        let c27hi: int = c27lo + chunk_size;
        spawn { ch.send(count_primes_range(c27lo, c27hi)); };
        let c28lo: int = 2 + 28 * chunk_size;
        let c28hi: int = c28lo + chunk_size;
        spawn { ch.send(count_primes_range(c28lo, c28hi)); };
        let c29lo: int = 2 + 29 * chunk_size;
        let c29hi: int = c29lo + chunk_size;
        spawn { ch.send(count_primes_range(c29lo, c29hi)); };
        let c30lo: int = 2 + 30 * chunk_size;
        let c30hi: int = c30lo + chunk_size;
        spawn { ch.send(count_primes_range(c30lo, c30hi)); };
        let c31lo: int = 2 + 31 * chunk_size;
        let c31hi: int = c31lo + chunk_size;
        spawn { ch.send(count_primes_range(c31lo, c31hi)); };

        // chunk 32..39
        let c32lo: int = 2 + 32 * chunk_size;
        let c32hi: int = c32lo + chunk_size;
        spawn { ch.send(count_primes_range(c32lo, c32hi)); };
        let c33lo: int = 2 + 33 * chunk_size;
        let c33hi: int = c33lo + chunk_size;
        spawn { ch.send(count_primes_range(c33lo, c33hi)); };
        let c34lo: int = 2 + 34 * chunk_size;
        let c34hi: int = c34lo + chunk_size;
        spawn { ch.send(count_primes_range(c34lo, c34hi)); };
        let c35lo: int = 2 + 35 * chunk_size;
        let c35hi: int = c35lo + chunk_size;
        spawn { ch.send(count_primes_range(c35lo, c35hi)); };
        let c36lo: int = 2 + 36 * chunk_size;
        let c36hi: int = c36lo + chunk_size;
        spawn { ch.send(count_primes_range(c36lo, c36hi)); };
        let c37lo: int = 2 + 37 * chunk_size;
        let c37hi: int = c37lo + chunk_size;
        spawn { ch.send(count_primes_range(c37lo, c37hi)); };
        let c38lo: int = 2 + 38 * chunk_size;
        let c38hi: int = c38lo + chunk_size;
        spawn { ch.send(count_primes_range(c38lo, c38hi)); };
        let c39lo: int = 2 + 39 * chunk_size;
        let c39hi: int = c39lo + chunk_size;
        spawn { ch.send(count_primes_range(c39lo, c39hi)); };

        // chunk 40..47
        let c40lo: int = 2 + 40 * chunk_size;
        let c40hi: int = c40lo + chunk_size;
        spawn { ch.send(count_primes_range(c40lo, c40hi)); };
        let c41lo: int = 2 + 41 * chunk_size;
        let c41hi: int = c41lo + chunk_size;
        spawn { ch.send(count_primes_range(c41lo, c41hi)); };
        let c42lo: int = 2 + 42 * chunk_size;
        let c42hi: int = c42lo + chunk_size;
        spawn { ch.send(count_primes_range(c42lo, c42hi)); };
        let c43lo: int = 2 + 43 * chunk_size;
        let c43hi: int = c43lo + chunk_size;
        spawn { ch.send(count_primes_range(c43lo, c43hi)); };
        let c44lo: int = 2 + 44 * chunk_size;
        let c44hi: int = c44lo + chunk_size;
        spawn { ch.send(count_primes_range(c44lo, c44hi)); };
        let c45lo: int = 2 + 45 * chunk_size;
        let c45hi: int = c45lo + chunk_size;
        spawn { ch.send(count_primes_range(c45lo, c45hi)); };
        let c46lo: int = 2 + 46 * chunk_size;
        let c46hi: int = c46lo + chunk_size;
        spawn { ch.send(count_primes_range(c46lo, c46hi)); };
        let c47lo: int = 2 + 47 * chunk_size;
        let c47hi: int = c47lo + chunk_size;
        spawn { ch.send(count_primes_range(c47lo, c47hi)); };

        // chunk 48..55
        let c48lo: int = 2 + 48 * chunk_size;
        let c48hi: int = c48lo + chunk_size;
        spawn { ch.send(count_primes_range(c48lo, c48hi)); };
        let c49lo: int = 2 + 49 * chunk_size;
        let c49hi: int = c49lo + chunk_size;
        spawn { ch.send(count_primes_range(c49lo, c49hi)); };
        let c50lo: int = 2 + 50 * chunk_size;
        let c50hi: int = c50lo + chunk_size;
        spawn { ch.send(count_primes_range(c50lo, c50hi)); };
        let c51lo: int = 2 + 51 * chunk_size;
        let c51hi: int = c51lo + chunk_size;
        spawn { ch.send(count_primes_range(c51lo, c51hi)); };
        let c52lo: int = 2 + 52 * chunk_size;
        let c52hi: int = c52lo + chunk_size;
        spawn { ch.send(count_primes_range(c52lo, c52hi)); };
        let c53lo: int = 2 + 53 * chunk_size;
        let c53hi: int = c53lo + chunk_size;
        spawn { ch.send(count_primes_range(c53lo, c53hi)); };
        let c54lo: int = 2 + 54 * chunk_size;
        let c54hi: int = c54lo + chunk_size;
        spawn { ch.send(count_primes_range(c54lo, c54hi)); };
